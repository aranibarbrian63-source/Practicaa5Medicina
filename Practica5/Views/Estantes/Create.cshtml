@model Practica5.Models.Estante

@{
    ViewData["Title"] = "Nuevo Estante";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-success text-white p-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <h3 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap-fill me-2"></i> Nuevo Estante</h3>
                        <a asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </div>

                <div class="card-body p-4 bg-light">
                    <p class="text-muted mb-4 small">Configure la ubicación física donde se almacenarán los medicamentos.</p>

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold small text-uppercase text-success"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-tag"></i>
                                </span>
                                <input asp-for="Nombre" class="form-control border-start-0" placeholder="Ej: Estante A, Vitrina Principal..." />
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Ubicacion" class="form-label fw-bold small text-uppercase text-success"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <input asp-for="Ubicacion" class="form-control border-start-0" placeholder="Ej: Pasillo 1, Sector Norte..." />
                            </div>
                            <span asp-validation-for="Ubicacion" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold small text-uppercase text-success"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-layers"></i>
                                </span>
                                <input asp-for="Descripcion" class="form-control border-start-0" placeholder="Ej: Fila 3, Nivel Superior..." />
                            </div>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm rounded-pill">
                                <i class="bi bi-save2-fill me-2"></i> Registrar Estante
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-white border-top-0 p-3 text-center text-muted small">
                    <i class="bi bi-info-circle me-1"></i> Defina ubicaciones claras para facilitar la búsqueda.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}