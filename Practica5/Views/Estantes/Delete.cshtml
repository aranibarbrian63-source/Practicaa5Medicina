@model Practica5.Models.Estante

@{
    ViewData["Title"] = "Eliminar Estante";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3 border-top border-5 border-danger">
                <div class="card-header bg-white text-center p-4">
                    <div class="display-4 text-danger mb-2">
                        <i class="bi bi-exclamation-octagon"></i>
                    </div>
                    <h3 class="fw-bold text-dark">¿Eliminar esta ubicación?</h3>
                    <p class="text-muted small">Esta acción es permanente. Verifique que el estante esté vacío antes de continuar.</p>
                </div>

                <div class="card-body px-4">
                    <div class="list-group list-group-flush border rounded-3 overflow-hidden shadow-sm">
                        <div class="list-group-item d-flex justify-content-between align-items-center bg-light p-3">
                            <span class="text-muted small text-uppercase fw-bold">Nombre/Código</span>
                            <span class="fw-bold text-dark fs-5">@Html.DisplayFor(model => model.Nombre)</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                            <span class="text-muted small text-uppercase fw-bold">Ubicación</span>
                            <span class="text-dark"><i class="bi bi-geo-alt me-1 text-danger"></i> @Html.DisplayFor(model => model.Ubicacion)</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                            <span class="text-muted small text-uppercase fw-bold">Detalles</span>
                            <span class="text-secondary italic">
                                @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción detallada" : Model.Descripcion)
                            </span>
                        </div>
                    </div>

                    <form asp-action="Delete" class="mt-5">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm fw-bold rounded-pill">
                                <i class="bi bi-trash3-fill me-2"></i> Confirmar y Eliminar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill border-0">
                                <i class="bi bi-arrow-left"></i> Cancelar, mantener estante
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light p-3 text-center border-0">
                    <span class="text-muted extra-small font-italic">
                        <i class="bi bi-shield-lock-fill me-1"></i> Control de Inventario v1.0
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .italic {
        font-style: italic;
    }

    .extra-small {
        font-size: 0.75rem;
    }
    /* Efecto de pulso suave al icono para llamar la atención */
    .bi-exclamation-octagon {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.1);
            opacity: 0.8;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>