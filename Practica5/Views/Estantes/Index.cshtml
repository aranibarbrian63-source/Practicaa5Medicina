@model IEnumerable<Practica5.Models.Estante>

@{
    ViewData["Title"] = "Control de Estantes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border-start border-4 border-success">
        <div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-door-open-fill text-success me-2"></i> Gestión de Estantes
            </h2>
            <p class="text-muted mb-0">Administre las ubicaciones físicas de los medicamentos</p>
        </div>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Estante
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.Ubicacion)</th>
                        <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3">
                                        <i class="bi bi-grid-3x3"></i>
                                    </div>
                                    <span class="fw-bold fs-6">@Html.DisplayFor(modelItem => item.Nombre)</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    @Html.DisplayFor(modelItem => item.Ubicacion)
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @(string.IsNullOrEmpty(item.Descripcion) ? "Sin detalles" : item.Descripcion)
                                </small>
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group shadow-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalles">
                                        <i class="bi bi-info-circle"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-archive-fill display-1 text-muted opacity-25"></i>
            <p class="mt-3 text-secondary">No hay estantes configurados en el sistema.</p>
        </div>
    }
</div>

<style>
    /* Efecto hover profesional */
    .table-hover tbody tr:hover {
        background-color: rgba(25, 135, 84, 0.05); /* Verde muy sutil */
        transition: background-color 0.2s ease;
    }
    /* Estilo para los botones */
    .btn-group .btn {
        padding: 0.375rem 0.6rem;
    }
</style>