@model Practica5.Models.ViewModels.LoginVM

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // Usamos null para que el fondo colorido ocupe toda la pantalla
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        :root {
            /* Colores llamativos y modernos */
            --primary-grad: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            --btn-grad: linear-gradient(to right, #11998e, #38ef7d);
            --glass-bg: rgba(255, 255, 255, 0.92);
        }

        body {
            /* CAMBIO DE FONDO: Degradado vibrante en lugar de blanco */
            background: #3a7bd5;
            background: var(--primary-grad);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            overflow: hidden;
        }

        .login-container {
            animation: slideUp 0.7s ease-out;
            width: 100%;
            max-width: 420px;
            padding: 15px;
        }

        .card {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border: none;
            border-radius: 25px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }

        .icon-box {
            width: 85px;
            height: 85px;
            background: var(--btn-grad);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: -40px auto 20px;
            box-shadow: 0 8px 15px rgba(17, 153, 142, 0.3);
            transform: rotate(-5deg);
        }

            .icon-box i {
                font-size: 2.8rem;
                color: white;
                transform: rotate(5deg);
            }

        .form-floating > .form-control {
            border: 2px solid transparent;
            background-color: #f1f5f9;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .form-floating > .form-control:focus {
                background-color: #ffffff;
                border-color: #11998e;
                box-shadow: 0 0 0 0.25rem rgba(17, 153, 142, 0.1);
            }

        .btn-login {
            background: var(--btn-grad);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.4s;
        }

            .btn-login:hover {
                transform: scale(1.03);
                box-shadow: 0 5px 15px rgba(56, 239, 125, 0.4);
                color: white;
            }

        .register-link {
            color: #11998e;
            font-weight: 700;
            text-decoration: none;
        }

            .register-link:hover {
                text-decoration: underline;
            }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Burbujas decorativas de fondo */
        .bubble {
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            z-index: -1;
            animation: float 20s infinite linear;
        }

        @@keyframes float {
            from {
                transform: translateY(100vh) scale(0);
            }

            to {
                transform: translateY(-10vh) scale(1.5);
            }
        }
    </style>
</head>
<body>

    <div class="bubble" style="width: 80px; height: 80px; left: 10%; animation-delay: 0s;"></div>
    <div class="bubble" style="width: 120px; height: 120px; left: 70%; animation-delay: 5s;"></div>
    <div class="bubble" style="width: 60px; height: 60px; left: 40%; animation-delay: 2s;"></div>

    <div class="login-container">
        <div class="card p-4">
            <div class="icon-box">
                <i class="bi bi-capsule-pill"></i>
            </div>

            <div class="text-center mb-4">
                <h2 class="fw-bold text-dark mb-0">FarmaSist</h2>
                <small class="text-muted">Gestión de Inventario Profesional</small>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="usuario@farmacia.com" required />
                    <label asp-for="Email" class="text-muted"><i class="bi bi-envelope me-2"></i>Email</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Contraseña" required />
                    <label asp-for="Password" class="text-muted"><i class="bi bi-lock me-2"></i>Contraseña</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" style="cursor:pointer;" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Recordarme</label>
                    </div>
                    <a href="#" class="small register-link">¿Olvidó su clave?</a>
                </div>

                <button type="submit" class="btn btn-login w-100 shadow-sm">
                    Acceder <i class="bi bi-box-arrow-in-right ms-2"></i>
                </button>

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="text-muted small">
                        ¿Nuevo en el sistema?
                        <a asp-action="Register" class="register-link">Crear cuenta</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>