@model IEnumerable<Practica5.Models.Medicamento>

@{
    ViewData["Title"] = "Reporte Crítico de Vencimientos";
    var hoy = DateTime.Now;
    var vencidosCount = Model.Count(m => m.FechaVencimiento < hoy);
    var porVencerCount = Model.Count(m => m.FechaVencimiento >= hoy);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded shadow-sm border-start border-5 border-danger">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-calendar-x text-danger me-2"></i> Control de Vencimientos
            </h2>
            <p class="text-muted mb-0">Listado de productos con fecha de expiración crítica (Próximos 30 días).</p>
        </div>
        <div class="d-none d-md-block">
            <button onclick="window.print()" class="btn btn-outline-dark shadow-sm">
                <i class="bi bi-printer me-2"></i> Exportar a PDF / Imprimir
            </button>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-6">
            <div class="card bg-danger text-white shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase small fw-bold">Ya Vencidos</h6>
                        <h3 class="mb-0 fw-bold">@vencidosCount productos</h3>
                    </div>
                    <i class="bi bi-x-octagon fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-warning text-dark shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase small fw-bold">Por Vencer (30 días)</h6>
                        <h3 class="mb-0 fw-bold">@porVencerCount productos</h3>
                    </div>
                    <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Medicamento</th>
                        <th>Categoría</th>
                        <th>Ubicación</th>
                        <th>Fecha Expiración</th>
                        <th class="text-center">Estado Crítico</th>
                        <th class="text-center pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderBy(m => m.FechaVencimiento))
                    {
                        var esVencido = item.FechaVencimiento < hoy;

                        <tr class="@(esVencido ? "table-danger" : "")">
                            <td class="ps-4">
                                <div class="fw-bold">@item.Nombre</div>
                                <small class="text-muted">Stock disponible: @item.Stock</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Categoria?.Nombre</span>
                            </td>
                            <td>
                                <i class="bi bi-layers text-muted me-1"></i> @item.Estante?.Nombre
                            </td>
                            <td>
                                <div class="fw-bold @(esVencido ? "text-danger" : "text-dark")">
                                    @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                </div>
                                <small class="text-muted">(@((item.FechaVencimiento - hoy).Days) días restantes)</small>
                            </td>
                            <td class="text-center">
                                @if (esVencido)
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">
                                        <i class="bi bi-trash3-fill me-1"></i> RETIRAR INMEDIATAMENTE
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                        <i class="bi bi-clock-history me-1"></i> LIQUIDAR PRONTO
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Volver al Inventario Completo
        </a>
    </div>
</div>

<style>
    /* Optimización para impresión */
    @@media print {
        .navbar, .btn, footer, .badge.bg-light {
            display: none !important;
        }

        .card {
            border: 1px solid #dee2e6 !important;
            shadow: none !important;
        }

        .table-danger {
            background-color: #f8d7da !important;
            -webkit-print-color-adjust: exact;
        }
    }
</style>