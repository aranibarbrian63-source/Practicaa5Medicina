@model IEnumerable<Practica5.Models.Medicamento>

@{
    ViewData["Title"] = "Reporte de Vencimientos";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Control de Vencimientos</h2>
    <p class="text-muted">Medicamentos vencidos o que vencen en los próximos 30 días.</p>

    <table class="table table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Medicamento</th>
                <th>Categoría</th>
                <th>Fecha de Vencimiento</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var esVencido = item.FechaVencimiento < DateTime.Now;
                <tr class="@(esVencido ? "table-danger" : "table-warning")">
                    <td>@item.Nombre</td>
                    <td>@item.Categoria?.Nombre</td>
                    <td>@item.FechaVencimiento.ToShortDateString()</td>
                    <td>
                        <strong>@(esVencido ? "VENCIDO" : "PRÓXIMO A VENCER")</strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary">Volver al Inventario</a>
</div>