@model IEnumerable<Practica5.Models.Medicamento>

@{
    ViewData["Title"] = "Inventario de Medicamentos";
}

<div class="container-fluid py-4 px-lg-5">
    @* --- CABECERA --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-box-seam-fill text-primary me-2"></i>Control de Inventario</h2>
            <p class="text-muted mb-0">Gestione el stock, precios y vencimientos de sus productos.</p>
        </div>
        @* El Farmacéutico y el Admin pueden crear nuevos productos *@
        @if (User.IsInRole("Administrador") || User.IsInRole("Farmacéutico"))
        {
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-pill px-4">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Producto
            </a>
        }
    </div>

    @* --- DASHBOARD DE ESTADOS (Punto 5 de la Práctica) --- *@
    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-collection-fill text-primary fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Total Productos</small>
                        <h4 class="fw-bold mb-0">@Model.Count()</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Stock Bajo (< 10)</small>
                        <h4 class="fw-bold mb-0">@Model.Count(m => m.Stock < 10)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-calendar-x-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Vencidos</small>
                        <h4 class="fw-bold mb-0 text-danger">@Model.Count(m => m.FechaVencimiento <= DateTime.Now)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-clock-history text-info fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Próximos Vencer (30d)</small>
                        <h4 class="fw-bold mb-0">@Model.Count(m => m.FechaVencimiento > DateTime.Now && m.FechaVencimiento <= DateTime.Now.AddDays(30))</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- FILTROS --- *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="buscarNombre" class="form-control border-start-0 ps-0"
                               placeholder="Buscar por nombre..." value="@ViewData["FiltroNombre"]">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="filtrarCategoria" class="form-select" asp-items="ViewBag.Categorias">
                        <option value="">-- Todas las Categorías --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-3">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    @* --- TABLA DE MEDICAMENTOS --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fs-xs fw-bold text-secondary">Producto / Info</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-secondary text-center">Categoría</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-secondary text-center">Stock</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-secondary text-center">Precio</th>
                        <th class="py-3 text-uppercase fs-xs fw-bold text-secondary text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-light rounded-circle p-2 me-3 text-center" style="width: 45px; height: 45px;">
                                        <i class="bi bi-capsule text-primary fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">@item.Nombre</h6>
                                        <small class="text-muted d-block">@item.Concentracion</small>

                                        @* --- ALERTAS DE FECHA (Punto 4 del PDF) --- *@
                                        @if (item.FechaVencimiento <= DateTime.Now)
                                        {
                                            <span class="badge bg-danger rounded-pill px-2" style="font-size: 0.7rem;">VENCIDO</span>
                                        }
                                        else if (item.FechaVencimiento <= DateTime.Now.AddDays(30))
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-2" style="font-size: 0.7rem;">Vence pronto</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill fw-medium">
                                    <i class="bi bi-tag-fill me-1"></i> @item.Categoria?.Nombre
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.Stock <= 5)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-arrow-down-circle-fill me-1"></i>@item.Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark">@item.Stock</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="fw-bold text-success">@item.Precio.ToString("C", new System.Globalization.CultureInfo("en-US"))</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm rounded-3 overflow-hidden">
                                    @* Ambos roles pueden editar/ver *@
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-sm border-end" title="Editar">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white btn-sm border-end" title="Detalles">
                                        <i class="bi bi-eye text-info"></i>
                                    </a>

                                    @* --- SEGURIDAD: Solo el Admin puede borrar --- *@
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-white btn-sm" title="Eliminar">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .fs-xs {
        font-size: 0.7rem;
        letter-spacing: 0.5px;
    }

    .btn-white {
        background: white;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
        }

    .table thead th {
        border-top: none;
        background-color: #f9fafb;
    }

    .avatar-sm {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card {
        transition: transform 0.2s;
    }
</style>