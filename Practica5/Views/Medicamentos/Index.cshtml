@model IEnumerable<Practica5.Models.Medicamento>

@{
    ViewData["Title"] = "Inventario de Medicamentos";
}

<h1 class="mt-4">Inventario de Farmacia</h1>

@* El botón de Crear solo aparece para personal de farmacia *@
@if (User.IsInRole("Administrador") || User.IsInRole("Farmacéutico"))
{
    <p>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nuevo Medicamento</a>
    </p>
}

<form asp-action="Index" method="get" class="mb-4 p-3 border rounded bg-light shadow-sm">
    <div class="row">
        <div class="col-md-4">
            <label class="form-label fw-bold">Buscar por nombre:</label>
            <input type="text" name="buscarNombre" value="@ViewData["FiltroNombre"]" class="form-control" placeholder="Ej: Paracetamol..." />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Filtrar por Categoría:</label>
            <select name="filtrarCategoria" class="form-select" asp-items="ViewBag.Categorias">
                <option value="">-- Todas las categorías --</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Aplicar Filtros</button>
        </div>
    </div>
</form>

<table class="table table-hover border shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Precio)</th>
            <th>@Html.DisplayNameFor(model => model.Stock)</th>
            <th>Categoría</th>
            <th>Estante</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@item.Precio.ToString("C")</td>
                <td>
                    @if (item.Stock <= 5)
                    {
                        <span class="badge bg-danger">@item.Stock (Bajo Stock)</span>
                    }
                    else
                    {
                        @item.Stock
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Categoria.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Estante.Nombre)</td>
                <td>
                    <div class="btn-group" role="group">
                        @if (User.IsInRole("Administrador") || User.IsInRole("Farmacéutico"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        }

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>

                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Borrar</a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>