@model Practica5.Models.Categoria

@{
    ViewData["Title"] = "Detalles de Categoría";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-gradient bg-primary text-white p-4 border-bottom-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h3 class="fw-bold mb-0">
                                <i class="bi bi-info-circle-fill me-2"></i> Detalles de Categoría
                            </h3>
                            <small class="opacity-75">ID de Registro: #@Model.Id.ToString("D3")</small>
                        </div>
                        <i class="bi bi-bookmark-star display-6 opacity-50"></i>
                    </div>
                </div>

                <div class="card-body p-4 bg-white">
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold letter-spacing-1">Nombre de la Categoría</label>
                        <div class="fs-4 fw-bold text-dark border-start border-4 border-primary ps-3 mt-1">
                            @Html.DisplayFor(model => model.Nombre)
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold letter-spacing-1">Descripción Detallada</label>
                        <div class="p-3 bg-light rounded-3 mt-2 border">
                            <i class="bi bi-chat-left-text me-2 text-primary small"></i>
                            <span class="text-secondary">
                                @(string.IsNullOrEmpty(Model.Descripcion) ? "No hay una descripción registrada para esta categoría." : Model.Descripcion)
                            </span>
                        </div>
                    </div>

                    <hr class="my-4 opacity-25">

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Regresar
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4 rounded-pill fw-bold">
                            <i class="bi bi-pencil-fill me-1"></i> Editar Información
                        </a>
                    </div>
                </div>

                <div class="card-footer bg-light p-3 text-center">
                    <span class="text-muted small">
                        <i class="bi bi-clock-history me-1"></i> Sistema de Inventario Farmacia v1.0
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Efecto de espaciado para etiquetas de texto */
    .letter-spacing-1 {
        letter-spacing: 1px;
    }
    /* Degradado para la cabecera */
    .bg-gradient {
        background: linear-gradient(45deg, #0d6efd, #0dcaf0);
    }
</style>