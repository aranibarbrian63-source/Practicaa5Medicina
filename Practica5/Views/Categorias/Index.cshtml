@model IEnumerable<Practica5.Models.Categoria>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border-start border-4 border-info">
        <div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-tags-fill text-info me-2"></i> Categorías de Medicamentos
            </h2>
            <p class="text-muted mb-0">Organiza tu inventario por familias de productos</p>
        </div>
        <a asp-action="Create" class="btn btn-info text-white fw-bold shadow-sm">
            <i class="bi bi-plus-lg"></i> Nueva Categoría
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 me-3">
                                        <i class="bi bi-tag"></i>
                                    </div>
                                    <span class="fw-bold fs-6">@Html.DisplayFor(modelItem => item.Nombre)</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción adicional" : item.Descripcion)
                                </span>
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group shadow-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalles">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-folder-x display-1 text-muted"></i>
            <p class="mt-3 text-secondary">No hay categorías registradas aún.</p>
        </div>
    }
</div>

<style>
    /* Efecto hover suave en las filas */
    .table-hover tbody tr:hover {
        background-color: rgba(13, 202, 240, 0.05);
        transition: 0.3s;
    }
    /* Estilo para los botones de la tabla */
    .btn-group .btn {
        padding: 0.4rem 0.7rem;
    }
</style>