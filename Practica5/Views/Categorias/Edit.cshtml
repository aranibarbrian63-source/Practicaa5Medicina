@model Practica5.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3 border-top border-5 border-warning">
                <div class="card-header bg-white p-4">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning text-dark rounded-circle p-3 me-3">
                            <i class="bi bi-pencil-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0 text-dark">Modificar Categoría</h3>
                            <small class="text-muted">Actualice los datos de la categoría seleccionada</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold text-dark small text-uppercase"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-fonts"></i>
                                </span>
                                <input asp-for="Nombre" class="form-control border-start-0" placeholder="Nombre de la categoría..." />
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small ms-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold text-dark small text-uppercase"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted align-items-start pt-2">
                                    <i class="bi bi-card-text"></i>
                                </span>
                                <textarea asp-for="Descripcion" class="form-control border-start-0" rows="4" placeholder="Descripción opcional..."></textarea>
                            </div>
                            <span asp-validation-for="Descripcion" class="text-danger small ms-1"></span>
                        </div>

                        <hr class="my-4 opacity-25">

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill px-5 fw-bold shadow-sm">
                                <i class="bi bi-save-fill me-2"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-white text-center py-3">
                    <span class="text-muted small">ID de categoría: #@Model.Id</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}