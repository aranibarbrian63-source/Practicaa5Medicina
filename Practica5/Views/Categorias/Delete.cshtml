@model Practica5.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-3 border-top border-5 border-danger">
                <div class="card-header bg-white text-center p-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
                    <h3 class="mt-2 fw-bold text-dark">¿Eliminar Categoría?</h3>
                    <p class="text-muted">Esta acción no se puede deshacer y podría afectar a los medicamentos asociados.</p>
                </div>

                <div class="card-body px-5">
                    <div class="bg-light p-3 rounded-3 mb-4">
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-bold text-uppercase small text-muted">Nombre:</div>
                            <div class="col-sm-8 text-dark fw-bold">@Html.DisplayFor(model => model.Nombre)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 fw-bold text-uppercase small text-muted">Descripción:</div>
                            <div class="col-sm-8 text-dark">
                                @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm fw-bold">
                                <i class="bi bi-trash-fill me-2"></i> Confirmar Eliminación
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i> Cancelar y volver
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-white text-center py-3">
                    <small class="text-muted italic">Asegúrese de que no existan medicamentos vinculados a esta categoría antes de proceder.</small>
                </div>
            </div>
        </div>
    </div>
</div>